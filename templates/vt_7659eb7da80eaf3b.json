              "type": [
                "integer",
                "null"
              ]
            },
            "convertMs": {
              "type": "integer"
            },
            "fetchMs": {
              "type": "integer"
            },
            "renderMs": {
              "type": [
                "integer",
                "null"
              ]
            },
            "totalMs": {
              "type": "integer"
            }
          },
          "type": "object",
          "required": [
            "convertMs",
            "fetchMs",
            "totalMs"
          ]
        },
        "title": {
          "description": "also sent percent-encoded as X-Url2md-Title",
          "type": [
            "string",
            "null"
          ]
        },
        "tokensEstimate": {

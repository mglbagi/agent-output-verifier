            "combination_checks": {
              "description": "Rule-period and BY-part checks",
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            "periods_checked": {
              "description": "Frequency periods visited",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "candidate_occurrences",
            "combination_checks",
            "periods_checked"
          ],
          "type": "object"
        }
      },
      "required": [

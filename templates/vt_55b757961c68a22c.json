                "properties": {
                  "bridge": {
                    "description": "Related bridge name",
                    "maxLength": 64,
                    "type": "string"
                  },
                  "docs": {
                    "description": "Related bridge documentation URL",
                    "format": "uri",
                    "maxLength": 512,
                    "type": "string"
                  },
                  "summary": {
                    "description": "Short capability summary",
                    "maxLength": 256,
                    "type": "string"
                  },
                  "url": {
                    "description": "Related route URL",
                    "format": "uri",
                    "maxLength": 512,
                    "type": "string"
                  }
                },
                "required": [
                  "bridge",
                  "url",
                  "docs",
                  "summary"

            "description": "Warning",
            "type": "string"
          },
          "maxItems": 100,
          "type": "array"
        },
        "window_end": {
          "description": "Normalized exclusive UTC window end",
          "format": "date-time",
          "type": "string"
        },
        "window_start": {
          "description": "Normalized inclusive UTC window start",
          "format": "date-time",
          "type": "string"
        },
        "work": {
